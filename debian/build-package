#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=${VERSION:-0.1.0-1}

for tool in dpkg-deb dpkg-architecture go npm node; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Required build tool not found: $tool" >&2
        exit 1
    fi
done

case "$(uname -s)" in
    Linux) ;;
    *) echo "Build the .deb on Debian/Ubuntu Linux so native Node modules match the target system." >&2; exit 1 ;;
esac

DEB_ARCH=$(dpkg-architecture -qDEB_HOST_ARCH)
case "$DEB_ARCH" in
    amd64) GOARCH=amd64 ;;
    arm64) GOARCH=arm64 ;;
    *) echo "Unsupported Debian architecture: $DEB_ARCH" >&2; exit 1 ;;
esac

STAGE="$ROOT/build/deb-root"
OUT="$ROOT/dist"
rm -rf "$STAGE"
mkdir -p "$STAGE/DEBIAN" "$STAGE/usr/bin" \
    "$STAGE/usr/lib/actual-bank-sync/helper" \
    "$STAGE/usr/share/doc/actual-bank-sync" \
    "$STAGE/etc/cron.d" "$STAGE/etc/logrotate.d"

(cd "$ROOT" && GOOS=linux GOARCH="$GOARCH" CGO_ENABLED=0 go build -trimpath \
    -o "$STAGE/usr/bin/actual-bank-sync" \
    ./cmd/actual-bank-sync)

cp "$ROOT/helper/actual-api.mjs" "$ROOT/helper/package.json" \
    "$ROOT/helper/package-lock.json" "$STAGE/usr/lib/actual-bank-sync/helper/"
npm ci --omit=dev --prefix "$STAGE/usr/lib/actual-bank-sync/helper"

cp "$ROOT/config.example.yaml" "$STAGE/usr/share/doc/actual-bank-sync/config.example.yaml"
cp "$ROOT/debian/cron.d" "$STAGE/etc/cron.d/actual-bank-sync"
cp "$ROOT/debian/logrotate" "$STAGE/etc/logrotate.d/actual-bank-sync"
chmod 0755 "$STAGE/usr/bin/actual-bank-sync"
chmod 0644 "$STAGE/etc/cron.d/actual-bank-sync" \
    "$STAGE/etc/logrotate.d/actual-bank-sync" \
    "$STAGE/usr/share/doc/actual-bank-sync/config.example.yaml"
cp "$ROOT/debian/postinst" "$STAGE/DEBIAN/postinst"
chmod 0755 "$STAGE/DEBIAN/postinst"
sed -e "s/@VERSION@/$VERSION/g" -e "s/@ARCH@/$DEB_ARCH/g" \
    "$ROOT/debian/control.in" > "$STAGE/DEBIAN/control"

mkdir -p "$OUT"
dpkg-deb --build --root-owner-group "$STAGE" \
    "$OUT/actual-bank-sync_${VERSION}_${DEB_ARCH}.deb"
echo "Built $OUT/actual-bank-sync_${VERSION}_${DEB_ARCH}.deb"